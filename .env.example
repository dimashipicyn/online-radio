# ===== VPS / стрим =====
# дом (профиль local): контейнер icecast; прод: IP вашего VPS
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=radio.mp3
# пароль source-клиента (станция -> icecast). Сгенерируйте: scripts/init-env.sh
ICECAST_SOURCE_PASSWORD=CHANGE_ME_source_pass
ICECAST_ADMIN_PASSWORD=CHANGE_ME_admin_pass
ICECAST_PUBLIC_PORT=8000

# ===== веб-UI =====
WEB_PORT=3000
ADMIN_PASSWORD=CHANGE_ME_admin

# ===== frp туннель (этап 2) =====
FRP_TOKEN=CHANGE_ME_frp_token
FRP_SERVER_PORT=7000

# ===== DJ =====
# 4070 (12GB): qwen2.5:7b-instruct-q4_K_M | 3050 (4GB): qwen2.5:3b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
DJ_NAME=Валера
RADIO_NAME=Радио Слом
# голоса Silero v4_ru: aidar | baya | kseniya | xenia | eugene | random
DJ_SPEAKER=eugene
CALLER_SPEAKER=kseniya
DJ_ENABLED=1
DJ_LEAD_SEC=30
DJ_CHATTER_CHANCE=0.4
KB_TOP_K=3
# своё описание персоны ведущего (перекрывает дефолт из кода)
# DJ_STYLE=Ты — дед Валера, 60 лет, ведёшь пиратское радио из гаража...
DJ_MAX_TOKENS=400
TZ=Europe/Moscow

# ===== звук =====
AUDIO_BITRATE=192

# ===== музыка =====
# папка с треками (bind в контейнер как /music, read-only)
# пример: /mnt/f/romantic-collection (диск F:) или дефолт ./music
MUSIC_DIR=./music
# false — спич-режим: эфир без музыки
MUSIC_ENABLED=true
